		<style id='custom-css-pro'>input[type=radio],
input.radio {
  float: left;
  clear: none;
  margin: 6px 4px 0 2px;
}

select#mce-POSITION {
    width: 72%;
    height: 28px;
}

select#mce-FIELD {
    width: 72%;
    height: 28px;
}


