	float: left;
}

#lakpage #nav-primary {
	margin-top: 0px;
}

.no-parent {
	background: transparent;
}

.solar-website-menu-item {
	right: 0;
	position: absolute !important;
}

.blogs #summaryContainer {
	display: none;
}

.blogs > .post-date {
	display: none;
}

.category-researcher-critique .post-date {
	visibility: hidden;
	font-size: 10px;
}


